# PostgreSQL connection string
DATABASE_URL="postgresql://simorgh:simorgh@localhost:5432/simorgh_ledger"

# Secret used to sign session JWTs (min 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-secret-string-at-least-32-chars"

# Bootstrap super admin (used by `npm run db:seed`)
SUPERADMIN_EMAIL="admin@simorgh.local"
SUPERADMIN_PASSWORD="ChangeMe123!"
SUPERADMIN_NAME="مدیر سیمرغ"

# App
NODE_ENV="development"

# ── Keycloak sign-in (realm kara) — leave empty for Kara's own passwords ──
# KEYCLOAK_ISSUER="https://auth.simorghai.com/realms/kara"
# KEYCLOAK_INTERNAL_URL=""            # the same realm inside the cluster (optional)
# KEYCLOAK_CLIENT_ID="kara-web"
# KEYCLOAK_CLIENT_SECRET=""
# APP_URL="http://localhost:3000"
# PASSWORD_LOGIN="false"              # "true" keeps the password form beside Keycloak
# KARA_API_URL="http://localhost:3001" # services/kara-api (Odoo data, Keycloak users)
