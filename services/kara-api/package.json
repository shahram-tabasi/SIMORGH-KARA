{
  "name": "@simorgh/kara-api",
  "version": "1.0.0",
  "private": true,
  "description": "Kara's API: Keycloak identities for Kara accounts, Odoo read models (from erp.* events) and writes through the erp-connector.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/infra && cp src/infra/schema.sql dist/infra/",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --outDir dist-test && node --test 'dist-test/**/*.spec.js'"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "jose": "5.10.0",
    "kafkajs": "2.2.4",
    "pg": "8.16.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.19.25",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
